# ==========================================
# UPSTOX API CREDENTIALS
# ==========================================
# Obtain these from: https://account.upstox.com/developer/apps
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/

# Optional: For fully automated daily 2FA login (if supported by your setup)
UPSTOX_USER_ID=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# ==========================================
# TRADING CONFIGURATION
# ==========================================
# Default instrument to trade (e.g. NSE_INDEX|Nifty 50, NSE_EQ|INE002A01018 for Reliance, etc.)
DEFAULT_INSTRUMENT_KEY=NSE_EQ|INE002A01018
DEFAULT_SYMBOL=RELIANCE
TIMEFRAME=1minute

# Risk Management
MAX_CAPITAL=50000
MAX_DAILY_LOSS=2000
RISK_PER_TRADE_PERCENT=1.0
STOP_LOSS_PERCENT=0.8
TAKE_PROFIT_PERCENT=1.6

# AI Model settings
AI_CONFIDENCE_THRESHOLD=0.65

# Google Drive storage directory (Colab will use /content/drive/MyDrive/upstox_ai_bot)
DRIVE_PROJECT_DIR=upstox_ai_bot
